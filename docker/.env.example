# ============================================================
# THESIS HITL SYSTEM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your own values.
# ============================================================

# PostgreSQL
POSTGRES_DB=hitl_thesis
POSTGRES_USER=hitl_user
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_random_password

# n8n database connection
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=hitl_thesis
DB_POSTGRESDB_USER=hitl_user
DB_POSTGRESDB_PASSWORD=CHANGE_ME_to_a_strong_random_password

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Host port (change if 5680 is taken)
N8N_HOST_PORT=5680

# Generate your own: openssl rand -base64 24
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand

# Local timezone
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
N8N_WEBHOOK_URL=http://localhost:5680/
N8N_EDITOR_BASE_URL=http://localhost:5680/
